---
// Bläddra, as a graph: every institution, subject, programme and course plan as a point,
// laid out when the site is built. The same structure as the columns, seen whole.
import "../../../styles/graph.css"
import Page from "../../../layouts/Page.astro"
import BrowseViews from "../../../components/BrowseViews.astro"
import { link } from "../../../lib/site"
import { INSTITUTIONS, INSTITUTION_NAMES } from "../../../lib/vault"
---

<Page title="Graf" current="bladdra">
  <main class="graphpage">
    <h1 class="sr">Graf över institutioner, ämnen, program och kursplaner</h1>
    <div class="viewrow"><BrowseViews current="graf" /></div>

    <div class="glass large stage" data-graph data-src={link("/bladdra/graf.json")} data-base={link("")}>
      <canvas role="img" aria-label="Graf: varje institution med sina ämnen, program och kursplaner som punkter. Samma innehåll finns som listor under Kolumner."></canvas>

      <div class="gbar gzoom" role="group" aria-label="Zooma">
        <button type="button" data-zoom="out" aria-label="Zooma ut"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button>
        <button type="button" data-zoom="in" aria-label="Zooma in"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8M7 3v8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button>
        <button type="button" data-zoom="fit" aria-label="Visa hela grafen"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 5.5v-3h3M11.5 5.5v-3h-3M2.5 8.5v3h3M11.5 8.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
      </div>

      <div class="gbar glegend" role="group" aria-label="Visa">
        {
          INSTITUTIONS.map((i) => (
            <button type="button" data-only={i} data-inst={i} aria-pressed="false" title={INSTITUTION_NAMES[i]}><span class="idot" aria-hidden="true" />{i}</button>
          ))
        }
        <button type="button" data-vilande aria-pressed="true"><span class="vdot" aria-hidden="true"></span>Vilande</button>
      </div>
      <p class="gbar gkey" aria-hidden="true">
        <span><i class="k-hub"></i>Ämne</span>
        <span><i class="k-prog"></i>Program</span>
        <span><i class="k-plan"></i>Kursplan</span>
      </p>

      <div class="gcard" data-card hidden>
        <div>
          <p class="gcard-title" data-card-title></p>
          <p class="gcard-sub" data-card-sub></p>
        </div>
        <a class="pill tint" data-card-link href="#">Öppna</a>
      </div>
      <p class="ghint" data-hint>Skrolla för att zooma, dra för att flytta. Peka på något för att se vad det hör ihop med.</p>
      <div class="tip" role="tooltip" data-tip></div>
    </div>
  </main>

  <script>
    import "../../../scripts/graph"
  </script>
</Page>
