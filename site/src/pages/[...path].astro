---
// Every note that does not have a design of its own: the subject and institution lists and
// the analysis notes. They sit in the same shell, on one sheet, with the note's own text set
// as written. Plans, the home page, the browser, the graph and the dashboard have their own pages.
import "../styles/doc.css"
import Page from "../layouts/Page.astro"
import T from "../components/T.astro"
import { getVault } from "../lib/vault"
import { renderMarkdown, withoutH1 } from "../lib/markdown"
import { link } from "../lib/site"
import { attrs, instName, type Key } from "../lib/ui"
import { CHECK_EN, PROBLEM_EN, checkName } from "../lib/checks"
import { both, bilingualLabels, englishIntro, englishSection, sections, HEADING_EN } from "../lib/analysis-en"

export function getStaticPaths() {
  return getVault()
    .docs.filter((doc) => doc.kind !== "course" && doc.kind !== "programme" && doc.kind !== "home")
    .map((doc) => ({
      params: { path: doc.url.replace(/^\/|\/$/g, "") || undefined },
      props: { file: doc.file },
    }))
}

const vault = getVault()
const doc = vault.byFile.get(Astro.props.file)!
const inst = doc.inst?.toLowerCase()

// Where the note sits, as places in the designed pages: the browser for the lists, the
// dashboard for analysis notes.
const trail: { k?: Key; text?: string; href: string }[] =
  doc.kind === "analysis"
    ? [{ k: "menu.kvalitet", href: "/kvalitet/" }, { text: doc.inst!, href: `/kvalitet/#${inst}/${doc.url.split("/")[3]}` }]
    : doc.kind === "analysisHub"
      ? [{ k: "menu.kvalitet", href: `/kvalitet/#${inst}` }]
      : doc.kind === "institution"
        ? [{ k: "menu.bladdra", href: `/bladdra/#${inst}` }]
        : [{ text: doc.inst!, href: `/bladdra/#${inst}` }]
const section = doc.kind === "analysis" || doc.kind === "analysisHub" ? "kvalitet" : "bladdra"

// An analysis note and a school's overview of them are the site's own analysis, so in English
// mode they read in English where a translation is up to date (lib/analysis-en.ts). Each
// translated section is in the page twice, one shown at a time; the findings tables are in it
// once, with English twins for their labels.
const isAnalysis = doc.kind === "analysis"
const isHub = doc.kind === "analysisHub"
const twice = (sv: string, en: string) => `<div data-l="sv">${sv}</div><div data-l="en" lang="en">${en}</div>`
async function analysisBody(): Promise<string> {
  const out: string[] = []
  for (const s of sections(doc.body)) {
    if (!s.heading) {
      if (!s.body) continue
      const sv = await renderMarkdown(s.body, doc)
      const en = isHub && doc.inst ? englishIntro(s.body, doc.inst) : null
      out.push(en ? twice(sv, await renderMarkdown(en, doc)) : sv)
      continue
    }
    const sv = await renderMarkdown(`## ${s.heading}\n\n${s.body}`, doc)
    const headEn = HEADING_EN[s.heading]
    const en = isAnalysis ? englishSection(doc.title, s.heading, s.body) : null
    if (en && headEn) out.push(twice(sv, await renderMarkdown(`## ${headEn}\n\n${en}`, doc)))
    else out.push(headEn ? sv.replace(`>${s.heading}</h2>`, `>${both(s.heading, headEn)}</h2>`) : sv)
  }
  return bilingualLabels(out.join("\n"), CHECK_EN, PROBLEM_EN)
}
const body = isAnalysis || isHub ? await analysisBody() : await renderMarkdown(withoutH1(doc.body), doc)
const titleEn =
  doc.kind === "institution" && doc.inst ? instName(doc.inst, "en")
  : isAnalysis ? checkName(doc.title, "en")
  : isHub && doc.inst ? `${doc.inst} analyses`
  : undefined
const backlinks = doc.backlinks
  .map((f) => vault.byFile.get(f)!)
  .filter((b) => b.kind !== "analysis" && b.kind !== "analysisHub")
  .sort((a, b) => a.title.localeCompare(b.title, "sv"))
---

<Page title={doc.title} titleEn={titleEn} current={section}>
  <main class="doc">
    <div class="top">
      <nav class="crumbs" {...attrs({ "aria-label": "crumbs.label" })}>
        {
          trail.map((step, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">›</span>}
              <a href={link(step.href)}>{step.k ? <T k={step.k} /> : step.text}</a>
            </>
          ))
        }
      </nav>
    </div>

    <article class="glass large sheet">
      {/* A school, a check and an overview go by their names in the interface language; any other note keeps its own. */}
      <h1>{doc.kind === "institution" && doc.inst ? <T sv={instName(doc.inst, "sv")} en={instName(doc.inst, "en")} /> : titleEn ? <T sv={doc.title} en={titleEn} /> : doc.title}</h1>
      <div class="prose" set:html={body} />

      {
        backlinks.length > 0 && (
          <aside class="backlinks">
            <h2><T k="doc.linksHere" /></h2>
            <ul>
              {backlinks.map((b) => (
                <li><a href={link(b.url)}>{b.code && b.kind !== "subject" ? `${b.code} ${b.title}` : b.title}</a></li>
              ))}
            </ul>
          </aside>
        )
      }
    </article>
  </main>
</Page>
