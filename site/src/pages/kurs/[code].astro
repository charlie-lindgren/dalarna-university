---
// A course plan.
import "../../styles/plan.css"
import Page from "../../layouts/Page.astro"
import PlanPage from "../../components/PlanPage.astro"
import { getVault } from "../../lib/vault"
import { planView } from "../../lib/plan"

export function getStaticPaths() {
  return getVault()
    .docs.filter((d) => d.kind === "course")
    .map((d) => ({ params: { code: d.url.split("/")[2] }, props: { file: d.file } }))
}

const view = await planView(getVault().byFile.get(Astro.props.file)!)
---

<Page title={`${view.code} ${view.title}`}>
  <!-- The view is settled before first paint: from the link (?lang=both), else the reader's
       last choice, else Swedish. plan.css keys everything on this attribute. -->
  <script is:inline slot="head">
    (function () {
      var ok = function (v) { return v === "sv" || v === "en" || v === "both" }
      var v = new URLSearchParams(location.search).get("lang")
      if (!ok(v)) { try { v = localStorage.getItem("plan-view") } catch (e) {} }
      document.documentElement.dataset.view = ok(v) ? v : "sv"
    })()
  </script>
  <PlanPage view={view} />
</Page>
