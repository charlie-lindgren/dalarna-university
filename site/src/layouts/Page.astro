---
// The shell every page sits in: house tokens, the soft colour fields behind the glass, the
// menu, and the reader's own settings (appearance, interface language) applied before
// first paint.
import "../styles/base.css"
import "../styles/site.css"
import SiteBar, { type Section } from "../components/SiteBar.astro"
import { base, link } from "../lib/site"
import { t } from "../lib/ui"

interface Props {
  /** The page's own title, in Swedish. Leave out on the home page. */
  title?: string
  /** The same in English, where the title is the site's own words and not a plan's name. */
  titleEn?: string
  /** Which menu item this page belongs under, if any. */
  current?: Section
  brand?: boolean
}
const { title, titleEn, current, brand } = Astro.props
const full = (lang: "sv" | "en") => {
  const own = lang === "en" ? (titleEn ?? title) : title
  return own ? `${own} · ${t("site.name", lang)}` : t("site.name", lang)
}
// Links the reader hovers are fetched ahead, so the next page is there when they click.
// Prefetch only (not prerender), and never the downloads.
const speculation = JSON.stringify({
  prefetch: [{ where: { and: [{ href_matches: `${base}/*` }, { not: { href_matches: "/*.xlsx" } }, { not: { href_matches: "/*.json" } }] }, eagerness: "moderate" }],
})
---

<!doctype html>
<html lang="sv" data-en-title={full("en")}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    {/* The page's own background, known before any file has loaded. Otherwise a browser that
        paints a frame while the stylesheet is still on its way (as happens when its cached
        copy has gone stale) paints its default white, which shows as a flash between pages.
        The colours are base.css's --bg; the reader's own choice (data-theme) wins over the
        system's, as in base.css. */}
    <meta name="color-scheme" content="light dark" />
    <style is:inline>
      html { background: #EDEFF4; }
      @media (prefers-color-scheme: dark) { html:not([data-theme="light"]) { background: #111318; } }
      html[data-theme="dark"] { background: #111318; }
    </style>
    <title>{full("sv")}</title>
    <link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
    {base.endsWith("/next") && <meta name="robots" content="noindex" />}
    <!-- The browser's own chrome takes the page colour, per colour scheme. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#EDEFF4" data-light="#EDEFF4" data-dark="#111318" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111318" data-light="#EDEFF4" data-dark="#111318" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme")
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = m.dataset[t]
        }
      } catch (e) {}
      // The interface language: from the link (?ui=en), else the reader's last choice, else Swedish.
      ;(function () {
        var q = new URLSearchParams(location.search).get("ui")
        var ui = q === "en" || q === "sv" ? q : null
        try {
          if (ui) localStorage.setItem("ui", ui)
          else ui = localStorage.getItem("ui")
        } catch (e) {}
        document.documentElement.dataset.ui = ui === "en" ? "en" : "sv"
      })()
      // When the browser gives up on the fade between two pages (it may, at any time), the
      // page is simply there. That is no error, so it is not left to be reported as one.
      ;["pageswap", "pagereveal"].forEach(function (name) {
        addEventListener(name, function (e) {
          if (e.viewTransition) e.viewTransition.ready.catch(function () {})
        })
      })
    </script>
    {/* The fade between pages is switched on here, in the page itself, and not in a stylesheet.
        A stylesheet may have to be checked with the server again when a page arrives (its
        cached copy has gone stale), and a browser that finds the rule missing at that moment
        gives the fade up and reports an error. */}
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
    </style>
    <script type="speculationrules" is:inline set:html={speculation} />
    <slot name="head" />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <SiteBar current={current} brand={brand} />
    <slot />
    <script is:inline>
      // An attribute cannot hold two languages at once, so the ones that carry text
      // (aria-label, placeholder, title, and the page's own title) are switched here: once
      // right after the page is parsed, and again when the reader changes language.
      window.applyUiLanguage = function (lang) {
        var en = lang === "en"
        var root = document.documentElement
        document.querySelectorAll("[data-i18n]").forEach(function (el) {
          el.getAttribute("data-i18n").split(" ").forEach(function (name) {
            if (!el.hasAttribute("data-sv-" + name)) el.setAttribute("data-sv-" + name, el.getAttribute(name) || "")
            el.setAttribute(name, el.getAttribute("data-" + (en ? "en" : "sv") + "-" + name) || "")
          })
          // A control with no Swedish text of its own takes its label's language with it,
          // so a screen reader says the label right.
          if (el.hasAttribute("data-i18n-lang")) {
            if (en) el.setAttribute("lang", "en")
            else el.removeAttribute("lang")
          }
        })
        if (!root.hasAttribute("data-sv-title")) root.setAttribute("data-sv-title", document.title)
        document.title = (en && root.getAttribute("data-en-title")) || root.getAttribute("data-sv-title")
      }
      if (document.documentElement.dataset.ui === "en") window.applyUiLanguage("en")
    </script>
    <script>
      import "../scripts/site"
    </script>
  </body>
</html>
