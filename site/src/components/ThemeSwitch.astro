---
// Light / Dark / Match the system, as the house design language specifies.
import { attrs } from "../lib/ui"
---

<div class="theme" role="group" {...attrs({ "aria-label": "theme.label" }, { lang: true })}>
  <button type="button" data-theme-choice="light" aria-pressed="false" {...attrs({ "aria-label": "theme.light" }, { lang: true })}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"></circle><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false" {...attrs({ "aria-label": "theme.dark" }, { lang: true })}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 9.9A5.6 5.6 0 0 1 6.1 2.8a5.6 5.6 0 1 0 7.1 7.1Z" fill="currentColor"></path></svg>
  </button>
  <button type="button" data-theme-choice="auto" aria-pressed="true" {...attrs({ "aria-label": "theme.auto" }, { lang: true })}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M8 2.4a5.6 5.6 0 0 1 0 11.2Z" fill="currentColor"></path></svg>
  </button>
</div>

<script>
  import "../scripts/theme"
</script>
