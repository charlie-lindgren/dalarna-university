---
// The bar across the top of every page: the site's name, the menu, and the two switches
// (language, appearance). The menu is one <nav> at every size: a segmented control here,
// a tab bar along the bottom on a phone.
import T from "./T.astro"
import LangSwitch from "./LangSwitch.astro"
import ThemeSwitch from "./ThemeSwitch.astro"
import { link } from "../lib/site"
import { attrs, type Key } from "../lib/ui"

export type Section = "sok" | "bladdra" | "graf" | "kvalitet"
interface Props {
  current?: Section
  /** The home page prints the name as its own heading, so it leaves it out up here. */
  brand?: boolean
}
const { current, brand = true } = Astro.props
const items: { id: Section; label: Key; href: string }[] = [
  { id: "sok", label: "menu.sok", href: "/" },
  { id: "bladdra", label: "menu.bladdra", href: "/bladdra/" },
  { id: "graf", label: "menu.graf", href: "/graf/" },
  { id: "kvalitet", label: "menu.kvalitet", href: "/kvalitet/" },
]
---

<header class="sitebar">
  <div class="sitebar-start">{brand && <a class="brand" href={link("/")}><T k="site.name" /></a>}</div>
  <nav class="sitemenu" {...attrs({ "aria-label": "menu.label" }, { lang: true })}>
    {
      items.map((i) => (
        <a href={link(i.href)} data-menu={i.id} aria-current={i.id === current ? "page" : undefined}>
          {i.id === current && <span class="thumb" aria-hidden="true" />}
          <span class="mi">
            {i.id === "sok" && <svg viewBox="0 0 22 22" aria-hidden="true"><circle cx="9.6" cy="9.6" r="6.1" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m14.3 14.3 4.6 4.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>}
            {i.id === "bladdra" && <svg viewBox="0 0 22 22" aria-hidden="true"><rect x="2.4" y="3.9" width="17.2" height="14.2" rx="3.4" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M8.4 4.2v13.6M14 4.2v13.6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>}
            {i.id === "graf" && <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M7 14.4 10.2 8M12.9 7.6l3.3 4.6M7.9 16l7-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="5.6" cy="16.4" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="11.4" cy="5.6" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="17.4" cy="14" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>}
            {i.id === "kvalitet" && <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M4 18.2V11M9 18.2V4.4M14 18.2v-9M19 18.2v-5.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
            <T k={i.label} />
          </span>
        </a>
      ))
    }
  </nav>
  <div class="sitebar-end"><LangSwitch /><ThemeSwitch /></div>
</header>
