{
  "name": "dalarna-university-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "rm -rf public/pagefind && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/redirects.ts && pagefind --site dist && rm -f dist/pagefind/pagefind-*ui* dist/pagefind/pagefind-highlight.js && cp -R dist/pagefind public/pagefind",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "report": "node scripts/report.ts",
    "check:links": "node scripts/check-links.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "d3-force": "^3.0.1",
    "d3-quadtree": "^3.0.2",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "rehype-callouts": "^2.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "rehype-parse": "^9.0.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
